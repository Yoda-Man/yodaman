{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "server.js",
    "start.js",
    "bin/yodaman.js",
    "src/main.jsx",
    "electron/main.js",
    "electron/preload.js",
    "extensions/vscode-yodaman/src/extension.js",
    "apps/mobile/App.js",
    "apps/mobile/metro.config.js",
    "scripts/*.js",
    "plugins/*.js",
    "frontend/UIPanel.js",
    "frontend/VRViewer.js",
    "shared/*.js",
    "tests/**/*.test.js",
    "vite.config.js",
    "tailwind.config.cjs",
    "postcss.config.cjs"
  ],
  "project": [
    "backend/**/*.js",
    "src/**/*.{js,jsx}",
    "frontend/**/*.{js,jsx}",
    "shared/**/*.js",
    "plugins/*.js",
    "electron/*.js",
    "scripts/*.js",
    "bin/*.js",
    "server.js",
    "start.js"
  ],
  "ignore": [
    "dist/**",
    "release/**",
    "graphify-out/**",
    "website/downloads/**",
    "tests/fixtures/**",
    "apps/mobile/node_modules/**",
    "extensions/vscode-yodaman/node_modules/**"
  ],
  "ignoreDependencies": [
    "autoprefixer",
    "concurrently",
    "electron-builder",
    "jest",
    "nodemon",
    "postcss"
  ],
  "ignoreBinaries": [
    "vsce"
  ]
}
