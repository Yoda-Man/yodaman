        <mxCell id="t1" value="&lt;b&gt;YodaMan — Deployment Diagram&lt;/b&gt;&lt;br&gt;All components run locally on the developer's machine. No cloud infrastructure required." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
