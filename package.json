{
  "name": "yodaman",
  "version": "0.6.2",
  "description": "YodaMan — local-first workspace intelligence. AI agent, semantic search, Graphify knowledge graphs, plugins, VS Code extension, mobile companion.",
  "author": "Marwa Trust Mutemasango <trustaldo@gmail.com>",
  "bin": {
    "yodaman": "bin/yodaman.js",
    "yodaman-mcp": "bin/yodaman-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "backend",
    "shared",
    "plugins",
    "!plugins/config.json",
    "server.js",
    "start.js",
    "public",
    "README.md",
    "user_manual.md",
    "config.example.json"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "server": "node server.js",
    "server:watch": "nodemon server.js",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run vendor:sync && vite build",
    "vendor:sync": "node scripts/sync-vendor.js",
    "desktop": "npm run build && electron electron/main.js",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.json --dir",
    "desktop:dist": "npm run build && npm run test:render && electron-builder --config electron-builder.json && npm run test:packaged && npm run website:downloads",
    "desktop:dist:all": "npm run build && npm run test:render && electron-builder --config electron-builder.json --mac --arm64 && npm run test:packaged && electron-builder --config electron-builder.json --win --linux --x64 && npm run website:downloads",
    "test:render": "jest tests/electron/DesktopRenderSmoke.test.js tests/electron/GraphRenderSmoke.test.js",
    "website:downloads": "node scripts/sync-website-downloads.js",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "jest",
    "generate:protocol": "node scripts/generate-protocol.js",
    "release:smoke": "node scripts/release-smoke.js",
    "audit:vendored": "node scripts/audit-vendored.js",
    "test:plugins": "node scripts/plugin-smoke.js",
    "release:verify": "npm run version:check && npm run build && npm run lint && npm test && npm run test:coverage && npm run audit:prod && npm run audit:vendored && npm run release:smoke && npm run test:journeys && npm run test:plugins && npm run test:approval && npm run test:packaged",
    "test:approval": "node scripts/approval-smoke.js",
    "health:watch": "node scripts/health-watchdog.js",
    "health:check": "node scripts/health-watchdog.js --once",
    "test:journeys": "node scripts/journey-smoke.js",
    "test:packaged": "node scripts/packaged-smoke.js",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "screenshots": "electron scripts/capture-screenshots.js",
    "screenshots:gif": "bash scripts/make-demo-gif.sh",
    "version:check": "node scripts/bump-version.js --check",
    "version:bump": "node scripts/bump-version.js",
    "vendor:holocron": "node scripts/sync-holocron-layout.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "simple-git": "^4.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@babel/traverse": "^8.0.10",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.65.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "vis-network": "^10.1.4",
    "vite": "^8.3.5"
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0"
  },
  "license": "MIT",
  "private": false,
  "keywords": [
    "yodaman",
    "ai-agent",
    "code-search",
    "knowledge-graph",
    "developer-tools",
    "workspace-intelligence",
    "local-first",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoda-Man/yodaman.git"
  },
  "bugs": {
    "url": "https://github.com/Yoda-Man/yodaman/issues"
  },
  "homepage": "https://github.com/Yoda-Man/yodaman#readme",
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "maxWorkers": "50%",
    "transform": {
      "^.+\\.m?jsx?$": "<rootDir>/tests/helpers/sucraseTransform.js"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/tests/helpers/styleStub.js",
      "\\.(png|jpe?g|gif|svg|woff2?|ttf|eot)$": "<rootDir>/tests/helpers/styleStub.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(three|chokidar|readdirp)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/release",
      "<rootDir>/dist",
      "<rootDir>/extensions/vscode-yodaman/node_modules",
      "<rootDir>/.claude/worktrees"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/release",
      "<rootDir>/dist",
      "<rootDir>/extensions/vscode-yodaman/node_modules",
      "<rootDir>/.claude/worktrees"
    ],
    "collectCoverageFrom": [
      "backend/**/*.js",
      "shared/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 62,
        "branches": 51,
        "functions": 58,
        "lines": 63
      }
    },
    "setupFiles": [
      "<rootDir>/tests/helpers/isolateData.js"
    ]
  },
  "allowScripts": {
    "electron-winstaller": false,
    "unrs-resolver": false,
    "@parcel/watcher": false
  }
}
