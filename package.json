{
  "name": "yodaman",
  "version": "0.3.1",
  "description": "YodaMan — local-first workspace intelligence. AI agent, semantic search, Graphify knowledge graphs, plugins, VS Code extension, mobile companion.",
  "author": "Marwa Trust Mutemasango <trustaldo@gmail.com>",
  "bin": {
    "yodaman": "bin/yodaman.js"
  },
  "files": [
    "bin",
    "dist",
    "backend",
    "shared",
    "server.js",
    "start.js",
    "public",
    "docs/*.md",
    "!docs/audit*.md",
    "!docs/ecosystem-roadmap.md",
    "README.md",
    "config.example.json"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "server": "node server.js",
    "server:watch": "nodemon server.js",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "desktop": "npm run build && electron electron/main.js",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.json --dir",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.json && npm run website:downloads",
    "desktop:dist:all": "npm run build && electron-builder --config electron-builder.json --mac --arm64 && electron-builder --config electron-builder.json --win --linux --x64 && npm run website:downloads",
    "website:downloads": "node scripts/sync-website-downloads.js",
    "preview": "vite preview",
    "test": "jest",
    "generate:protocol": "node scripts/generate-protocol.js",
    "release:smoke": "node scripts/release-smoke.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.0.0",
    "glob": "^10.0.0",
    "lucide-react": "^0.292.0",
    "multer": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "private": false,
  "keywords": [
    "yodaman",
    "ai-agent",
    "code-search",
    "knowledge-graph",
    "developer-tools",
    "workspace-intelligence",
    "local-first",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoda-Man/yodaman.git"
  },
  "bugs": {
    "url": "https://github.com/Yoda-Man/yodaman/issues"
  },
  "homepage": "https://github.com/Yoda-Man/yodaman#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/release",
      "<rootDir>/dist",
      "<rootDir>/extensions/vscode-yodaman/node_modules"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/release",
      "<rootDir>/dist",
      "<rootDir>/extensions/vscode-yodaman/node_modules"
    ]
  }
}
