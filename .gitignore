# Dependencies
node_modules/
apps/*/node_modules/
extensions/*/node_modules/

# Web/runtime build output
dist/
release/
coverage/
config.json
reasonix.toml
.reasonix/
audit-log.json
task-history.json
audit-log.jsonl
task-history.jsonl

# Local user data — chat history and the runtime database must never be committed
sessions.json
yodaman.db

# Desktop clients
electron/dist/
electron/out/
electron/release/
*.dmg
*.exe
*.AppImage
*.deb
*.rpm

# VS Code plugins
extensions/vscode-yodaman/*.vsix
extensions/vscode-yodaman/.vscode-test/
extensions/vscode-yodaman/out/
extensions/vscode-yodaman/dist/

# Mobile apps — build output only. The blanket `apps/mobile/` rule that used to
# sit here also excluded the app's own source, so App.js, app.json, eas.json and
# the store assets were never in version control. node_modules is already
# covered by `apps/*/node_modules/` above.
apps/mobile/.expo/
apps/mobile/.expo-shared/
apps/mobile/dist/
apps/mobile/build/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/*.apk
apps/mobile/*.aab
apps/mobile/*.ipa
apps/mobile/.eas/

# OS/editor
.DS_Store
.vscode/
.superpowers/

# Website
website/downloads/

# Roadmaps/docs
docs/ecosystem-roadmap.md
docs/audit.md
docs/audit-remediation.md

# Database files
yodaman.db
yodaman.db-journal
yodaman.db-wal
yodaman.db-shm

# Graphify generated workspace artifacts
graphify-out/
yodaman-0.2.2.tgz
.yodaman-approval-smoke/

# Expo prebuild output — regenerated from app.json, never hand-edited.
apps/mobile/ios/
apps/mobile/android/

# asc CLI failure reports — diagnostic output, not source.
.asc/
