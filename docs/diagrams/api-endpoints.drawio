        <!-- Server info -->
        <mxCell id="info1" value="&lt;i&gt;All routes served by Express on port 3090.&lt;br&gt;Agent task endpoint uses SSE (Server-Sent Events).&lt;br&gt;Plugin upload accepts .js and .zip files.&lt;br&gt;Settings are persisted in config.json.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1">
