{
  "appId": "africa.criticalpath.yodaman",
  "productName": "YodaMan",
  "asar": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "backend/**/*",
    "dist/**/*",
    "plugins/**/*",
    "public/**/*",
    "server.js",
    "config.json",
    "package.json",
    "node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "mac": {
    "icon": "electron/assets/yodaman.icns",
    "target": [
      "dmg",
      "zip",
      "dir"
    ],
    "category": "public.app-category.developer-tools"
  },
  "win": {
    "icon": "electron/assets/yodaman.png",
    "target": [
      "nsis",
      "zip",
      "dir"
    ]
  },
  "linux": {
    "icon": "electron/assets/yodaman.png",
    "maintainer": "YodaMan <trustaldo@gmail.com>",
    "target": [
      "AppImage",
      "zip",
      "dir"
    ],
    "category": "Development"
  }
}
