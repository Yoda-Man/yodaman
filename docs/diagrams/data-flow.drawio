        </mxCell>
        <mxCell id="cr5" value="Save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="c3" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cr6" value="Answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="c3" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cr7" value="Result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="c2" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== PLUGIN UPLOAD FLOW ===== -->
        <mxCell id="fl3" value="&lt;b&gt;🟠 3. Plugin Upload Flow&lt;/b&gt;" style="swimlane;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="20" y="380" width="1100" height="150" as="geometry" />
        </mxCell>

        <mxCell id="u1" value="User" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="React UI" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="170" y="430" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="Multer\n(file receive)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="430" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="Extract + Merge\n(if zip)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
