<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="draw.io">
  <diagram id="api-endpoints" name="API Endpoints">
    <mxGraphModel dx="1420" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="&lt;b&gt;YodaMan — API Endpoints&lt;/b&gt;&lt;br&gt;52 routes grouped by domain. All served from backend/interfaces/RestController.js on port 3090." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="900" height="35" as="geometry" />
        </mxCell>

        <!-- Legend -->
