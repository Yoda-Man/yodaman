{
  "name": "yodaman",
  "version": "0.1.6",
  "description": "Web GUI for Context Expert (ctx)",
  "author": "YodaMan",
  "bin": {
    "yodaman": "bin/yodaman.js"
  },
  "files": [
    "bin",
    "dist",
    "backend",
    "server.js",
    "start.js",
    "public",
    "README.md",
    "config.json"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "server": "nodemon server.js",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "desktop": "npm run build && electron electron/main.js",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.json --dir",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.json && npm run website:downloads",
    "desktop:dist:all": "npm run build && electron-builder --config electron-builder.json --mac --arm64 && electron-builder --config electron-builder.json --win --linux --x64 && npm run website:downloads",
    "website:downloads": "node scripts/sync-website-downloads.js",
    "preview": "vite preview",
    "test": "jest"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/release",
      "<rootDir>/dist",
      "<rootDir>/extensions/vscode-yodaman/node_modules"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/release",
      "<rootDir>/dist",
      "<rootDir>/extensions/vscode-yodaman/node_modules"
    ]
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lucide-react": "^0.292.0",
    "multer": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
