        </mxCell>
        <mxCell id="u6" value="PluginAPI\nWrap legacy" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="u7" value="plugins/\nDirectory" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="430" width="90" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ur1" value="Upload .js/.zip" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="u1" target="u2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ur2" value="POST /plugins" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="u2" target="u3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ur3" value="unzip + merge permissions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="u3" target="u4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ur4" value="validatePlugin()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="u4" target="u5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ur5" value="Wrap if legacy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="u5" target="u6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ur6" value="Copy to plugins/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="u6" target="u7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Indexing flow -->
        <mxCell id="fl4" value="&lt;b&gt;🟣 4. Background Indexing Flow&lt;/b&gt;" style="swimlane;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="1100" height="100" as="geometry" />
        </mxCell>

        <mxCell id="x1" value="FileSystemWatcher" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="QueueService" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="590" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="ContextEngine" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="590" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="x4" value="ctx index" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="590" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="x5" value="Local SQLite DB" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="590" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="xr1" value="File changed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="x1" target="x2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xr2" value="Queue job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="x2" target="x3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xr3" value="Spawn ctx index" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="x3" target="x4">
