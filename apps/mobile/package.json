{
  "name": "yodaman-mobile",
  "version": "0.1.9",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "build:all": "npx eas-cli@latest build --platform all --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.11",
    "expo-splash-screen": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "shell-quote": "^1.12.0",
    "tar": "^7.5.21",
    "brace-expansion": "^2.1.7",
    "browserslist": "^4.29.5",
    "js-yaml": "^4.3.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {}
}
